<%- include('partials/header') %>

<main>
  <section class="page-header">
    <h1><%= title %></h1>
    <p>
      Meet the partner organizations that provide meaningful
      service opportunities in our communities.
    </p>
  </section>

  <section class="organizations">
    <div class="card-grid">

      <article class="organization-card">
        <img
          src="/images/brightfuture-logo.png"
          alt="Bright Future organization logo"
        >

        <div class="card-content">
          <h2>Bright Future</h2>
          <p>
            Supporting students and families through tutoring,
            mentoring, and educational service opportunities.
          </p>
        </div>
      </article>

      <article class="organization-card">
        <img
          src="/images/greenharvest-logo.png"
          alt="Green Harvest organization logo"
        >

        <div class="card-content">
          <h2>Green Harvest</h2>
          <p>
            Bringing volunteers together for environmental
            projects, community gardens, and conservation efforts.
          </p>
        </div>
      </article>

      <article class="organization-card">
        <img
          src="/images/unityserve-logo.png"
          alt="Unity Serve organization logo"
        >

        <div class="card-content">
          <h2>Unity Serve</h2>
          <p>
            Connecting volunteers with community service projects
            that support individuals and families in need.
          </p>
        </div>
      </article>

    </div>
  </section>
</main>

<%- include('partials/footer') %>