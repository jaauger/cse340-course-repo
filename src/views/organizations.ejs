<%- include('partials/header') %>

<main>
  <section class="page-header">
    <h1><%= title %></h1>

    <p>
      Meet the partner organizations that provide meaningful
      service opportunities in our communities.
    </p>
    
  </section>
    <div class="page-actions">
    <a href="/new-organization" class="button primary">
      Add a New Organization
    </a>
  </div>
  <section class="organizations">
    <div class="card-grid">

      <% organizations.forEach((organization) => { %>

        <article class="organization-card">

          <img
            src="/images/<%= organization.logo_filename %>"
            alt="<%= organization.name %> organization logo"
          >

          <div class="card-content">

            <h2>
              <a href="/organization/<%= organization.organization_id %>">
                <%= organization.name %>
              </a>
            </h2>

            <p>
              <%= organization.description %>
            </p>

            <p>
              <strong>Contact:</strong>
              <%= organization.contact_email %>
            </p>

            <div class="card-actions">
              <a
                href="/edit-organization/<%= organization.organization_id %>"
                class="card-action"
              >
                Edit Organization
              </a>
            </div>
          </div>
          
        </article>

      <% }); %>

    </div>
  </section> 
  
</main>

<%- include('partials/footer') %>