<%- include('partials/header', { title }) %>

<main>
  <section class="hero">
    <div class="hero-content">
      <p class="eyebrow">Serve your community</p>
      <h1>Make a difference where you live.</h1>

      <p>
        Discover meaningful volunteer opportunities and connect
        with organizations making an impact in your community.
      </p>

      <div class="hero-actions">
        <a class="button primary" href="/projects">
          Find a Project
        </a>

        <a class="button secondary" href="/organizations">
          View Organizations
        </a>
      </div>
    </div>

    <img
      class="main-logo"
      src="/images/cse340-service-network.png"
      alt="CSE 340 Service Network Logo"
    >
  </section>

  <section class="featured">
    <h2>Featured Service Projects</h2>

    <div class="card-grid">

      <article class="project-card">
        <h3>Community Park Cleanup</h3>
        <p>Help restore a local park and create a cleaner community.</p>
      </article>

      <article class="project-card">
        <h3>After-School Tutoring</h3>
        <p>Support students with homework, reading, and study skills.</p>
      </article>

      <article class="project-card">
        <h3>Community Food Drive</h3>
        <p>Collect and organize food donations for families in need.</p>
      </article>

    </div>
  </section>
</main>

<%- include('partials/footer') %>