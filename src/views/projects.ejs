<%- include('partials/header') %>

<main>
  <section class="page-header">
    <h1><%= title %></h1>
    <p>
      Explore service opportunities available through our
      partner organizations.
    </p>
  </section>

  <section class="featured">
    <div class="card-grid">

      <% projects.forEach((project) => { %>

        <article class="project-card">

          <h2>
            <%= new Date(project.project_date).toLocaleDateString('en-US', {
              year: 'numeric',
              month: 'long',
              day: 'numeric',
              timeZone: 'UTC'
            }) %>:
            <%= project.name %>
            (<em><%= project.organization_name %></em>)
          </h2>

          <p>
            <%= project.description %>
          </p>

          <p>
            <strong>Location:</strong>
            <%= project.location %>
          </p>

        </article>

      <% }); %>

    </div>
  </section>
</main>

<%- include('partials/footer') %>