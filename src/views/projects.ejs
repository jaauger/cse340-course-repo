<%- include('partials/header') %>

<main>
  <section class="page-header">
    <h1><%= title %></h1>
    <p>
      Explore service opportunities available through our
      partner organizations.
    </p>
  </section>

  <div class="page-actions">
    <% if (user && user.role_name === 'admin') { %>
      <a href="/new-project" class="button primary">
        Add a New Service Project
      </a>
    <% } %>  
    </div>
  
  <section class="featured">
    <div class="card-grid">

      <% projects.forEach((project) => { %>

        <article class="project-card">
          
            <p class="project-date">
              <%= new Date(project.date).toLocaleDateString('en-US', {
                  year: 'numeric',
                  month: 'long',
                  day: 'numeric',
                  timeZone: 'UTC'
              }) %>
          </p>
          
          <h2>
              <a
                  class="project-card-link"
                  href="/project/<%= project.project_id %>"
              >
                  <%= project.title %>
              </a>
          </h2>
          
          <p class="project-organization">
              <a
                  class="organization-link"
                  href="/organization/<%= project.organization_id %>"
              >
                  <%= project.organization_name %>
              </a>
          </p>        
        
          <p>
              <%= project.description %>
          </p>
        
          <p>
              <strong>Location:</strong>
              <%= project.location %>
          </p>

          <div class="card-actions">
            <% if (user && user.role_name === 'admin') { %>
              <a
                class="card-action"
                href="/edit-project/<%= project.project_id %>"
              >
                Edit Project
              </a>
            <% } %>
            <% if (user && user.role_name === 'admin') { %>  
              <a
                class="card-action"
                href="/assign-categories/<%= project.project_id %>"
              >
                Edit Categories
              </a>
            <% } %>  
            </div> 
  
        
      </article>

      <% }); %>

    </div>
  </section>
</main>

<%- include('partials/footer') %>