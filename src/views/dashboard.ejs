<%- include('partials/header') %>

<main>
    <section class="page-header">
        <h1><%= title %></h1>
        <p>Welcome, <%= name %>.</p>
    </section>

    <section class="account-panel">
        <h2>Account Information</h2>

        <div class="account-details">
            <div class="account-detail">
                <span class="account-label">Name</span>
                <span><%= name %></span>
            </div>

            <div class="account-detail">
                <span class="account-label">Email</span>
                <span><%= email %></span>
            </div>

            <div class="account-detail">
                <span class="account-label">Role</span>
                <span><%= role %></span>
            </div>
        </div>
    </section>

    <section class="account-panel">
        <h2>Project Volunteer Information</h2>

        <div>
            <% if (volunteerProjects.length > 0) { %>
                <p>You have volunteered for the following projects:</p>
                <div class="volunteer-projects">
                    <% volunteerProjects.forEach((project) => { %>
                        <div class="volunteer-project">
                        <a href="./project/<%= project.project_id %>" class="button primary"><%= project.name %></a>

                        <form class="volunteer-remove"
                              action="/remove-volunteer/<%= project.project_id %>"
                              method="POST">

                              <input type="hidden" name="redirectTo" value="dashboard">
                              
                              <button type="submit" aria-label="Remove <%= project.name %> from my volunteer projects">x</button>
                        </form>

                </div>        
                    <% }); %>
                </div>
            <% } else { %>
                <p>You have not volunteered for any projects</p>
            <% } %>
        </div>
    </section>

    <% if (role === 'admin') { %>
        <section class="admin-panel">
            <h2>Administration</h2>
            <p>Manage administrative features for the system.</p>

            <a href="/users" class="button primary">System Users</a>
        </section>
    <% } %>
</main>

<%- include('partials/footer') %>